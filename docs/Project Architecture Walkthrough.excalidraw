   "version": 1,
   "versionNonce": 1990525226,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why two queues? If the API thread wrote into the waiting queue directly,\ntwo threads would share scheduler state -> locks and races.",
   "originalText": "Why two queues? If the API thread wrote into the waiting queue directly,\ntwo threads would share scheduler state -> locks and races.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
