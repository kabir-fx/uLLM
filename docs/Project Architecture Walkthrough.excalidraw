  {
   "id": "4uooysquo721f9z2",
   "type": "text",
   "x": 302.88,
   "y": 9663.75,
   "width": 674.24,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1558117202,
   "version": 1,
   "versionNonce": 225709810,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The retry rule: retry ONLY before the first byte reaches the client.\nOnce tokens are streamed, a retry would repeat text the user already saw,\nso a mid-stream failure becomes an error event instead (S6).\nTimeouts (starting values): connect ~1 s, first token ~30 s, gap between chunks ~30 s.\nNo total timeout: a long answer is not a failure.",
   "originalText": "The retry rule: retry ONLY before the first byte reaches the client.\nOnce tokens are streamed, a retry would repeat text the user already saw,\nso a mid-stream failure becomes an error event instead (S6).\nTimeouts (starting values): connect ~1 s, first token ~30 s, gap between chunks ~30 s.\nNo total timeout: a long answer is not a failure.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "9kwrel763nu7wxii",
   "lineHeight": 1.25,
   "autoResize": true
  },
