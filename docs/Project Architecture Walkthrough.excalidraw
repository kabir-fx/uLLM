   "version": 1,
   "versionNonce": 1426466643,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Step 2 avoids busy-spinning: an idle loop would only heat a fanless Air.",
   "originalText": "Step 2 avoids busy-spinning: an idle loop would only heat a fanless Air.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
