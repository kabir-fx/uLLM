   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example: 3,000-token system prompt\n+ 50-token question -> 187 blocks hit,\nprefill 58 tokens instead of 3,050.\nIf every block hits, still recompute the\nlast token to get the next-token scores.",
   "originalText": "Example: 3,000-token system prompt\n+ 50-token question -> 187 blocks hit,\nprefill 58 tokens instead of 3,050.\nIf every block hits, still recompute the\nlast token to get the next-token scores.",
