  {
   "id": "k5t4inxsmfr5m9s9",
   "type": "text",
   "x": 721.16,
   "y": 6962.5,
   "width": 407.68000000000006,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
