   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Client disconnects mid-answer\nAPI notices -> abort ticket -> engine frees the blocks next\nstep. Otherwise dead requests burn GPU until max_tokens.\nFull inbound queue -> reply 503 (backpressure).",
   "originalText": "Client disconnects mid-answer\nAPI notices -> abort ticket -> engine frees the blocks next\nstep. Otherwise dead requests burn GPU until max_tokens.\nFull inbound queue -> reply 503 (backpressure).",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "ytpcqra67mzbq38a",
   "lineHeight": 1.25,
   "autoResize": true
  },
