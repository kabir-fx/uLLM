   "locked": false,
   "text": "NO -> DECODE step\nevery running request gets 1 token\ninput [B, 1], e.g. [3, 1] for A, B, D",
   "originalText": "NO -> DECODE step\nevery running request gets 1 token\ninput [B, 1], e.g. [3, 1] for A, B, D",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "i5izddr0l96thave",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "30jkdpjrufxq3vq0",
   "type": "text",
   "x": 680,
   "y": 5340,
   "width": 540.96,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 563461131,
   "version": 1,
   "versionNonce": 783077985,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "D gets its first token: that moment is D's TTFT.\nNext loop: nobody new joins -> decode step for A, B, D, input [3, 1].\nEvery decode loop gives each of them 1 more token: one TPOT.",
   "originalText": "D gets its first token: that moment is D's TTFT.\nNext loop: nobody new joins -> decode step for A, B, D, input [3, 1].\nEvery decode loop gives each of them 1 more token: one TPOT.",
