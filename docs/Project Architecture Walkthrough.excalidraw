   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One owner: the\nscheduler, blocks,\nKV pool and model\nare touched only\nhere, so no locks.",
   "originalText": "One owner: the\nscheduler, blocks,\nKV pool and model\nare touched only\nhere, so no locks.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "1c2io0dtln3v0dkc",
   "type": "text",
   "x": 1640,
   "y": 6862,
   "width": 483.84000000000003,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
