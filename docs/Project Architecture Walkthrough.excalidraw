  {
   "id": "xiizpc325q3ymtei",
   "type": "text",
   "x": 142.03999999999996,
   "y": 6962.5,
   "width": 465.9200000000001,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
