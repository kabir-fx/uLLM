  {
   "id": "5u6edlc9bdzbpl5i",
   "type": "text",
   "x": 1640,
   "y": 9645,
   "width": 298.48,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 820644504,
   "version": 1,
   "versionNonce": 1450708117,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Half-open lets ONE trial request through.\nIt fails -> Open again (upper arrow).\nIt succeeds -> Closed (lower arrow).\nReacts to real traffic instantly.",
   "originalText": "Half-open lets ONE trial request through.\nIt fails -> Open again (upper arrow).\nIt succeeds -> Closed (lower arrow).\nReacts to real traffic instantly.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "ndtkwe5xyjm1sco7",
   "type": "rectangle",
