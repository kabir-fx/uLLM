   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each replica is a full\nengine process: API +\nengine + its own KV\ncache. Caches are NOT\nshared between them.",
   "originalText": "Each replica is a full\nengine process: API +\nengine + its own KV\ncache. Caches are NOT\nshared between them.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "awr5yp267gg7cqsp",
   "type": "text",
   "x": 130,
   "y": 9300,
   "width": 182.00000000000003,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1760286652,
   "version": 1,
   "versionNonce": 402243948,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One Mac = one GPU: the\nreplicas share it, so\nthroughput may not grow.\nMeasure, report honestly.",
   "originalText": "One Mac = one GPU: the\nreplicas share it, so\nthroughput may not grow.\nMeasure, report honestly.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
