  {
   "id": "1leqfngs95upsrwd",
   "type": "text",
   "x": 1907.12,
   "y": 3691.25,
   "width": 305.76000000000005,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#2f9e44",
