   "link": null,
   "locked": false
  },
  {
   "id": "b8yub1gat5l334x0",
   "type": "text",
   "x": 729.0,
   "y": 9865.0,
   "width": 392.00000000000006,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 801995372,
   "version": 1,
   "versionNonce": 769500321,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Honest framing: one Mac\nThe replicas share one GPU and 16 GB, so this\nshows routing and failover, not more raw speed.\nOn a real cluster each replica is its own machine.",
   "originalText": "Honest framing: one Mac\nThe replicas share one GPU and 16 GB, so this\nshows routing and failover, not more raw speed.\nOn a real cluster each replica is its own machine.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "wx7l8ywgp1q2g3ho",
   "lineHeight": 1.25,
   "autoResize": true
  },
