   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Correction to Section 3\nThe router has no tokenizer, so it fingerprints\nmessage text, not the engine's token blocks.\nSame idea (chained hashes), coarser grain.",
   "originalText": "Correction to Section 3\nThe router has no tokenizer, so it fingerprints\nmessage text, not the engine's token blocks.\nSame idea (chained hashes), coarser grain.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "83itpp20la594ac6",
   "lineHeight": 1.25,
   "autoResize": true
  },
