   "updated": 1,
   "link": null,
   "locked": false,
   "text": "D's prompt fits in the free blocks -> D joins. E doesn't fit -> E stays at the\nfront, and nobody behind E may skip ahead (that is what FCFS means).",
   "originalText": "D's prompt fits in the free blocks -> D joins. E doesn't fit -> E stays at the\nfront, and nobody behind E may skip ahead (that is what FCFS means).",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
