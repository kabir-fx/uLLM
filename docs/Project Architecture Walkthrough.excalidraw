   "versionNonce": 191183168,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Measure: prefix hit rate (hit tokens /\nprompt tokens), TTFT cache on vs off\non workloads B and D, evictions.\nCI: greedy output identical, on vs off.\nRouter (S8) reuses these hashes.",
   "originalText": "Measure: prefix hit rate (hit tokens /\nprompt tokens), TTFT cache on vs off\non workloads B and D, evictions.\nCI: greedy output identical, on vs off.\nRouter (S8) reuses these hashes.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "7vnyriix367nilv8",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "bkq7f1mp58v3ctqh",
   "type": "text",
   "x": 140,
   "y": 3815,
   "width": 368.48,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#0c8599",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1707807884,
   "version": 1,
   "versionNonce": 1530800027,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Shared blocks are always full, so nobody writes\ninto them again. New tokens go into each\nrequest's own last block. Sharing is read-only.",
   "originalText": "Shared blocks are always full, so nobody writes\ninto them again. New tokens go into each\nrequest's own last block. Sharing is read-only.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
