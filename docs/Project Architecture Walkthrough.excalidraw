   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A, B, C:\nowned by\na request\n\nS (thick):\nshared prefix,\nref count > 1\n\nK (dashed):\nCached, ref 0,\nevictable (S3)\n\ngrey: free",
   "originalText": "A, B, C:\nowned by\na request\n\nS (thick):\nshared prefix,\nref count > 1\n\nK (dashed):\nCached, ref 0,\nevictable (S3)\n\ngrey: free",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "aotl4ldqotovmtb5",
   "type": "text",
   "x": 1575,
   "y": 11690,
   "width": 546.0,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 702735294,
   "version": 1,
   "versionNonce": 983966160,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Watch: blocks scatter (paging, S2), S stays put while users share it,\nK squares get evicted under pressure, a preempted request's squares vanish.",
   "originalText": "Watch: blocks scatter (paging, S2), S stays put while users share it,\nK squares get evicted under pressure, a preempted request's squares vanish.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
