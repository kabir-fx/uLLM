   "seed": 679753275,
   "version": 1,
   "versionNonce": 1458139660,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why only one thread touches MLX\nOne GPU, so extra threads would just queue up on it, and\nthey would race on block tables and the KV pool.\nOne owner = no locks, no races.",
   "originalText": "Why only one thread touches MLX\nOne GPU, so extra threads would just queue up on it, and\nthey would race on block tables and the KV pool.\nOne owner = no locks, no races.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "dbg1d441r8mo61hp",
   "lineHeight": 1.25,
   "autoResize": true
  },
