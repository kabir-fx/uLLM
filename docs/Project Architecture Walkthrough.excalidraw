   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Block states\n\nFree: empty, on the free list\n\nIn use: ref count >= 1,\nnever evicted\n\nCached: ref count 0, K,V and\nhash kept -> reused on a later\nhit, or evicted LRU when the\npool runs out\n\nNothing left to evict:\npreemption (S4)",
   "originalText": "Block states\n\nFree: empty, on the free list\n\nIn use: ref count >= 1,\nnever evicted\n\nCached: ref count 0, K,V and\nhash kept -> reused on a later\nhit, or evicted LRU when the\npool runs out\n\nNothing left to evict:\npreemption (S4)",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "1u2sm4tyfh2e21q5",
   "lineHeight": 1.25,
   "autoResize": true
  },
