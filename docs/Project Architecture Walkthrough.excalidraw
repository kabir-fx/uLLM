   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Plan, metrics, tests\nFirst: proxy, round-robin, health, timeouts, retries.\nThen: prefix-aware routing vs round-robin.\nMetrics: load per replica, decisions, retries, breaker.\nTest: kill a replica mid-run; no request is lost.",
   "originalText": "Plan, metrics, tests\nFirst: proxy, round-robin, health, timeouts, retries.\nThen: prefix-aware routing vs round-robin.\nMetrics: load per replica, decisions, retries, breaker.\nTest: kill a replica mid-run; no request is lost.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "ydqj874h2fmpnudh",
   "lineHeight": 1.25,
   "autoResize": true
  },
