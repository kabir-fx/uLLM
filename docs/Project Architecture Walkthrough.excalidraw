   "locked": false
  },
  {
   "id": "952w84xu51i2lycv",
   "type": "text",
   "x": 178.99999999999997,
   "y": 9856.25,
   "width": 392.00000000000006,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#9c36b5",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 783402488,
   "version": 1,
   "versionNonce": 1953853998,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why Go?\nBuilt for network servers: goroutines handle\nthousands of connections cheaply, and the standard\nlibrary has a reverse proxy. A separate process,\nso it stays up when an engine crashes.",
   "originalText": "Why Go?\nBuilt for network servers: goroutines handle\nthousands of connections cheaply, and the standard\nlibrary has a reverse proxy. A separate process,\nso it stays up when an engine crashes.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "ndtkwe5xyjm1sco7",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "wx7l8ywgp1q2g3ho",
   "type": "rectangle",
   "x": 660,
   "y": 9830,
   "width": 530,
   "height": 140,
   "angle": 0,
   "strokeColor": "#e03131",
