  {
   "id": "13ai88suyqwhufg9",
   "type": "text",
   "x": 1580,
   "y": 5090,
   "width": 439.04,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 754025612,
   "version": 1,
   "versionNonce": 1689163724,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A gets one of the freed blocks. A and B keep generating.",
   "originalText": "A gets one of the freed blocks. A and B keep generating.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "td6fgt6n2oihyf37",
   "type": "text",
   "x": 1580,
   "y": 5150,
   "width": 184.8,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#846358",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1344267189,
   "version": 1,
   "versionNonce": 975217061,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "4. Later: C comes back",
   "originalText": "4. Later: C comes back",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "xtwrmtsy9ck72vjb",
   "type": "text",
   "x": 1580,
   "y": 5180,
   "width": 470.40000000000003,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 28035091,
   "version": 1,
   "versionNonce": 1621447099,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "B finishes -> its blocks are freed -> C is let back in.\nC re-prefills its prompt + its old tokens to rebuild its K,V\n(often via prefix-cache hits), then keeps writing.\nThe user only sees a short pause. Nothing is repeated.",
   "originalText": "B finishes -> its blocks are freed -> C is let back in.\nC re-prefills its prompt + its old tokens to rebuild its K,V\n(often via prefix-cache hits), then keeps writing.\nThe user only sees a short pause. Nothing is repeated.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "j8dewvvajfh52e21",
   "type": "rectangle",
   "x": 1580,
   "y": 5290,
   "width": 660,
   "height": 170,
   "angle": 0,
   "strokeColor": "#846358",
   "backgroundColor": "#f8f1ee",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 960008238,
   "version": 1,
   "versionNonce": 216483436,
   "isDeleted": false,
   "boundElements": [
    {
     "type": "text",
     "id": "p7zbtoriss22yt8b"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "p7zbtoriss22yt8b",
   "type": "text",
   "x": 1670.8799999999999,
   "y": 5322.5,
   "width": 478.24000000000007,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#846358",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 278635045,
   "version": 1,
   "versionNonce": 1597553455,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why it's needed: admission only checks the prompt fits.\nNobody knows how long the answer will be, so memory can\nrun out mid-generation. Preemption is the safety valve.\nWhy the newest: least work to redo, oldest users keep moving.\nCost: C's re-prefill. Many preemptions = pool too small\nor batch cap too high (tracked as a metric).",
   "originalText": "Why it's needed: admission only checks the prompt fits.\nNobody knows how long the answer will be, so memory can\nrun out mid-generation. Preemption is the safety valve.\nWhy the newest: least work to redo, oldest users keep moving.\nCost: C's re-prefill. Many preemptions = pool too small\nor batch cap too high (tracked as a metric).",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "j8dewvvajfh52e21",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "0ic6lsdkfpfsrss6",
   "type": "rectangle",
   "x": 110,
   "y": 5540,
   "width": 520,
   "height": 170,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "#fff3bf",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1389543409,
   "version": 1,
   "versionNonce": 1427953870,
   "isDeleted": false,
   "boundElements": [
    {
     "type": "text",
     "id": "n1gany9qm72aqohh"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "n1gany9qm72aqohh",
   "type": "text",
   "x": 173.99999999999997,
   "y": 5563.75,
   "width": 392.00000000000006,
   "height": 122.5,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1955518166,
   "version": 1,
   "versionNonce": 1855757322,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Padding + mask (GPU math needs rectangles)\nPrefill: token rows padded to the longest prompt;\nwaste hits every layer (attention + MLP).\nDecode: input is [B, 1], no padding needed.\nOnly the gathered KV (different histories) is\npadded, and only attention sees it.\nMask = padded positions get zero attention weight.",
   "originalText": "Padding + mask (GPU math needs rectangles)\nPrefill: token rows padded to the longest prompt;\nwaste hits every layer (attention + MLP).\nDecode: input is [B, 1], no padding needed.\nOnly the gathered KV (different histories) is\npadded, and only attention sees it.\nMask = padded positions get zero attention weight.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "0ic6lsdkfpfsrss6",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "w6s60d7yui2qf5tp",
   "type": "rectangle",
   "x": 660,
   "y": 5540,
   "width": 540,
   "height": 170,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "#ffe3e3",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1924040296,
   "version": 1,
   "versionNonce": 19905215,
   "isDeleted": false,
   "boundElements": [
    {
     "type": "text",
     "id": "gfpfzdcnv11kf6ui"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "gfpfzdcnv11kf6ui",
   "type": "text",
   "x": 741.8399999999999,
   "y": 5572.5,
   "width": 376.32000000000005,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 747631665,
   "version": 1,
   "versionNonce": 1757505337,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Prefill-first trade-off\nWhile a prefill step runs, every running request\nskips that step, so its next token waits.\nWorkload C (one 8k prompt): TPOT p99 spikes and\nshort requests queue behind it (head-of-line\nblocking). Fix later: chunked prefill.",
   "originalText": "Prefill-first trade-off\nWhile a prefill step runs, every running request\nskips that step, so its next token waits.\nWorkload C (one 8k prompt): TPOT p99 spikes and\nshort requests queue behind it (head-of-line\nblocking). Fix later: chunked prefill.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "w6s60d7yui2qf5tp",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "o6cdfggrwkhr3eyg",
   "type": "rectangle",
   "x": 1230,
   "y": 5540,
   "width": 540,
   "height": 170,
   "angle": 0,
   "strokeColor": "#846358",
   "backgroundColor": "#f8f1ee",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 940300696,
   "version": 1,
   "versionNonce": 1739098853,
   "isDeleted": false,
   "boundElements": [
    {
     "type": "text",
     "id": "9zork1xdj3ooqvef"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "9zork1xdj3ooqvef",
   "type": "text",
   "x": 1304.0,
   "y": 5572.5,
   "width": 392.00000000000006,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#846358",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 602901257,
   "version": 1,
   "versionNonce": 1559220708,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Preemption = recompute\nFree the victim's blocks; its full blocks stay\nCached, so re-prefill often hits the prefix cache.\nIt goes to the FRONT of the queue and later\nre-prefills prompt + tokens already sent.\nNo swap to CPU: unified memory is the same RAM.",
   "originalText": "Preemption = recompute\nFree the victim's blocks; its full blocks stay\nCached, so re-prefill often hits the prefix cache.\nIt goes to the FRONT of the queue and later\nre-prefills prompt + tokens already sent.\nNo swap to CPU: unified memory is the same RAM.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "o6cdfggrwkhr3eyg",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "bjkvtsi1ppo0pj1p",
