  {
   "id": "vejyit8ch36j5hnj",
   "type": "text",
   "x": 790,
   "y": 3505,
   "width": 509.6,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1319555643,
   "version": 1,
   "versionNonce": 984033289,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why chain? The same 16 tokens after a different history have\ndifferent K,V, so a block's hash must cover everything before it.\nSame tokens, same order -> identical K,V -> safe to share.",
   "originalText": "Why chain? The same 16 tokens after a different history have\ndifferent K,V, so a block's hash must cover everything before it.\nSame tokens, same order -> identical K,V -> safe to share.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
