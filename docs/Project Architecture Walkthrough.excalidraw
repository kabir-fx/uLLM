   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Throttle, don't flood\nThe engine runs up to ~60 steps/s; people read a\nfew updates/s. Batch events ~15x/s; a KV snapshot\nis 1 byte per block (~2,300 bytes).",
   "originalText": "Throttle, don't flood\nThe engine runs up to ~60 steps/s; people read a\nfew updates/s. Batch events ~15x/s; a KV snapshot\nis 1 byte per block (~2,300 bytes).",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "pyxwrjef9h0jzvb5",
   "lineHeight": 1.25,
   "autoResize": true
  },
