  {
   "id": "mecdkmqahnwuf64i",
   "type": "text",
   "x": 1764.0,
   "y": 4200.0,
   "width": 392.00000000000006,
   "height": 210.0,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
