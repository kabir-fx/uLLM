   "version": 1,
   "versionNonce": 1819309122,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1 block = 16 tokens\nx 28 layers = ~1.8 MB\n\n4 GB pool = ~2,300 blocks\n= ~36,000 tokens,\nshared by all users\n\nWaste: at most 15 slots per\nrequest (its last block only)",
   "originalText": "1 block = 16 tokens\nx 28 layers = ~1.8 MB\n\n4 GB pool = ~2,300 blocks\n= ~36,000 tokens,\nshared by all users\n\nWaste: at most 15 slots per\nrequest (its last block only)",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "038adp1ipapwpf4y",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "te62pjlt1ug61kc5",
   "type": "text",
   "x": 880,
   "y": 2715,
   "width": 1293.6000000000001,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#846358",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 525799809,
   "version": 1,
   "versionNonce": 672524828,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Life cycle: prefill takes ceil(len / 16) blocks  ->  decode fills the last block, +1 block when full  ->  finish returns all blocks  ->  pool empty = preemption (S4)",
   "originalText": "Life cycle: prefill takes ceil(len / 16) blocks  ->  decode fills the last block, +1 block when full  ->  finish returns all blocks  ->  pool empty = preemption (S4)",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
