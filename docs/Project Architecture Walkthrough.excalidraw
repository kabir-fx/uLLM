   "versionNonce": 1860961225,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "MLX runs on the CPU there (the runner has no GPU), so CI stays small:\n~32 tokens per equivalence prompt, ~20 eval items. Full evals and\nbenchmarks run on your Mac, unattended.\nThreshold = baseline score minus a small noise margin, so a real\nquality drop turns CI red.",
   "originalText": "MLX runs on the CPU there (the runner has no GPU), so CI stays small:\n~32 tokens per equivalence prompt, ~20 eval items. Full evals and\nbenchmarks run on your Mac, unattended.\nThreshold = baseline score minus a small noise margin, so a real\nquality drop turns CI red.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
