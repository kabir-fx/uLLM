   "version": 1,
   "versionNonce": 1567609725,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why two threads?\nA step blocks for ~15 ms (decode) up to 100s of ms (prefill).\nInside the asyncio thread nothing else could run: no new\nrequests, no streaming, /health times out, router marks it dead.",
   "originalText": "Why two threads?\nA step blocks for ~15 ms (decode) up to 100s of ms (prefill).\nInside the asyncio thread nothing else could run: no new\nrequests, no streaming, /health times out, router marks it dead.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "y1v3p340qloktwx7",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "dbg1d441r8mo61hp",
   "type": "rectangle",
