{
  "name": "ullm-terminal",
  "private": true,
  "version": "0.0.0",
  "description": "uLLM's real-time terminal: telemetry from a trace file or a live stream (T1, T2).",
  "type": "module",
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "check:contracts": "node scripts/gen-contracts.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
